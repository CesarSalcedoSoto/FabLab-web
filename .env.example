# ===============================================
# Variables de Entorno - FabLab Production (Docker)
# ===============================================

# ========================
# POSTGRESQL (Payload CMS)
# ========================
POSTGRES_USER=fablab
POSTGRES_PASSWORD=fablab_secret_2024
POSTGRES_DB=fablab_blog
# Formato: postgres://usuario:password@host:puerto/database
# En Docker Compose el host debe ser "db"
DATABASE_URL=postgres://fablab:fablab_secret_2024@db:5432/fablab_blog

# ========================
# PAYLOAD CMS
# ========================
# Secreto para JWT - generar con: openssl rand -base64 32
PAYLOAD_SECRET=GENERATE_RANDOM_SECRET_32_CHARS

# ========================
# NEXT.JS WEB
# ========================
NEXT_PUBLIC_SERVER_URL=https://app.tudominio.com
NEXT_PUBLIC_VESSEL_API_URL=https://api.tudominio.com
NEXT_PUBLIC_LARAVEL_URL=https://api.tudominio.com

# ========================
# STRAPI (Legacy - opcional)
# ========================
NEXT_PUBLIC_STRAPI_URL=https://cms.tudominio.com
STRAPI_API_TOKEN=

# ========================
# NextAuth
# ========================
NEXTAUTH_URL=https://app.tudominio.com
NEXTAUTH_SECRET=CHANGE_ME

# ========================
# DOMINIOS (para SSL/Nginx)
# ========================
DOMAIN_WEB=app.tudominio.com
