# =====================================================
# FabLab - Variables de Entorno para Hostinger VPS
# Copiar a .env y configurar los valores
# =====================================================

# PostgreSQL
POSTGRES_USER=fablab
POSTGRES_PASSWORD=TU_PASSWORD_SEGURA_AQUI

# Payload CMS (generar con: openssl rand -hex 32)
PAYLOAD_SECRET=CAMBIAR_POR_SECRET_SEGURO

# URL pública de tu sitio (sin / al final)
# Ejemplo: https://fablab.tudominio.com
NEXT_PUBLIC_SERVER_URL=https://tu-dominio.com

# API Vessel (opcional, dejar vacío si no se usa)
NEXT_PUBLIC_VESSEL_API_URL=
